# ==============================================================================
# DAKSH FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` in the `frontend/` directory:
#   cp example_.env .env
# Note: In Vite, all client-exposed variables MUST start with the prefix `VITE_`
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Base URLs
# ------------------------------------------------------------------------------
# Base API endpoint for DAKSH Django backend services (accounts, skill_gap, etc.)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Root URL for media assets / uploaded resumes served by Django backend
VITE_BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Application Metadata & Environment
# ------------------------------------------------------------------------------
VITE_APP_TITLE=DAKSH - Placement Intelligence Platform
VITE_APP_ENV=development

