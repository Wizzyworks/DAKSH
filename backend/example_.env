# ==============================================================================
# DAKSH BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` in the `backend/` directory:
#   cp example_.env .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Set to True for local development, False in production
DEBUG=True

# Django Secret Key (Generate a random unique string for production)
SECRET_KEY=django-insecure-daksh-skill-gap-analysis-dev-key

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Set to 'False' to use local SQLite (zero-config, db.sqlite3 will be auto-created)
# Set to 'True' to connect to a local or remote PostgreSQL instance
USE_POSTGRES=False

# PostgreSQL Connection Credentials (Used when USE_POSTGRES=True)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=daksh
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Allowed frontend origins (Vite default is http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Groq LLM API Configuration (Resume Parsing & Skill Gap Diagnostic Engine)
# ------------------------------------------------------------------------------
# Get your API key from: https://console.groq.com/keys
# (If left empty, DAKSH will gracefully use deterministic heuristic fallbacks)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

