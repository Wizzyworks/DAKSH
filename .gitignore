.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Build Artifacts & Logs
dist/
build/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*