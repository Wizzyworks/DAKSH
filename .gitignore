# Dependencies & Package Managers
node_modules/
.pnp
.pnp.js
package-lock.json.bak
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
id_rsa*
id_ed25519*
*credentials*.json
*serviceAccountKey*.json
*client_secret*.json

# Data, Spreadsheets & Databases
*.xlsx
*.xls
*.csv
*.tsv
*.parquet
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.bak

# Office & Sensitive Documents
*.docx
*.doc
*.pptx
*.ppt
*.pdf

# Media, Photos & Uploads (Excluding frontend project UI assets)
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.bmp
*.tiff
*.mp4
*.mkv
*.mov
*.avi
# Allow UI icons/assets inside frontend codebase
!frontend/src/assets/**
!frontend/public/**

# Markdown Notes & Drafts (Keeping official project docs & README safe)
*.md
!README.md
!docs/**
!docs/**/*.md

# Temporary, Scratch & Upload Folders
temp/
tmp/
uploads/
media/
scratch/
*.tmp
*.bak
*.swp
*.swo

